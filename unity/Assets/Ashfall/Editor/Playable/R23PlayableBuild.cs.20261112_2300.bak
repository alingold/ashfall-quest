#if UNITY_EDITOR
using System;
using System.IO;
using UnityEditor;
using UnityEditor.Build.Reporting;
using UnityEditor.SceneManagement;
using UnityEditor.XR.Management;
using UnityEditor.XR.Management.Metadata;
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.Universal;
using UnityEngine.SceneManagement;
using UnityEngine.XR.Management;
using UnityEngine.XR.OpenXR;
using UnityEngine.XR.OpenXR.Features.Interactions;
using Ashfall.Integration.Playable;
namespace Ashfall.Editor.Playable
{
    public static class R23PlayableBuild
    {
        public const string ScenePath="Assets/Ashfall/Scenes/PlayableR23.unity";
        public static string Argument(string name,string fallback=null)
        {var a=Environment.GetCommandLineArgs();for(int i=0;i<a.Length-1;i++)if(a[i]==name)return a[i+1];return fallback;}
        static void Folder(string path){if(!Directory.Exists(path))Directory.CreateDirectory(path);}
        public static XRGeneralSettings Xr()
        {return Xr(BuildTargetGroup.Standalone);}
        static XRGeneralSettings Xr(BuildTargetGroup group)
        {
            const string path="Assets/XR/XRGeneralSettingsPerBuildTarget.asset";Folder("Assets/XR");
            var settings=AssetDatabase.LoadAssetAtPath<XRGeneralSettingsPerBuildTarget>(path);
            if(settings==null){settings=ScriptableObject.CreateInstance<XRGeneralSettingsPerBuildTarget>();AssetDatabase.CreateAsset(settings,path);}
            EditorBuildSettings.AddConfigObject(XRGeneralSettings.settingsKey,settings,true);
            if(!settings.HasSettingsForBuildTarget(group))settings.CreateDefaultSettingsForBuildTarget(group);
            if(!settings.HasManagerSettingsForBuildTarget(group))settings.CreateDefaultManagerSettingsForBuildTarget(group);
            var general=settings.SettingsForBuildTarget(group);general.InitManagerOnStart=true;
            var manager=general.Manager;manager.automaticLoading=true;manager.automaticRunning=true;
            if(!XRPackageMetadataStore.AssignLoader(manager,"UnityEngine.XR.OpenXR.OpenXRLoader",group))throw new Exception("OpenXR loader assignment failed");
            UnityEditor.XR.OpenXR.Features.FeatureHelpers.RefreshFeatures(group);
            var open=OpenXRSettings.GetSettingsForBuildTargetGroup(group);
            if(open==null)throw new Exception("Installed OpenXR settings asset missing");
            var touch=open.GetFeature<OculusTouchControllerProfile>();if(touch==null)throw new Exception("Installed Oculus Touch interaction profile missing");touch.enabled=true;
            if(group==BuildTargetGroup.Android)
            {
                var quest=open.GetFeature<UnityEngine.XR.OpenXR.Features.MetaQuestSupport.MetaQuestFeature>();
                if(quest==null)throw new Exception("Installed Meta Quest support feature missing");quest.enabled=true;EditorUtility.SetDirty(quest);
                open.renderMode=OpenXRSettings.RenderMode.SinglePassInstanced;
                open.latencyOptimization=OpenXRSettings.LatencyOptimization.PrioritizeInputPolling;
            }
            EditorUtility.SetDirty(touch);EditorUtility.SetDirty(open);EditorUtility.SetDirty(general);EditorUtility.SetDirty(manager);AssetDatabase.SaveAssets();return general;
        }
        public static void Prepare()
        {
            Folder("Assets/Ashfall/Scenes");Folder("Assets/Ashfall/Settings");AssetDatabase.Refresh();
            // Sparse legacy importer metadata selected Alpha8 and discarded the SVG's RGB.
            // Preserve source white glyphs AND the authored dark visor; shader tint cannot restore it.
            foreach(string guid in AssetDatabase.FindAssets("t:Texture2D",new[]{"Assets/Ashfall/Integration/Playable/UI/Resources/R23SourceUI","Assets/Ashfall/Integration/Playable/UI/Resources/R23MapThumbnails"}))
            {
                var importer=AssetImporter.GetAtPath(AssetDatabase.GUIDToAssetPath(guid)) as TextureImporter;if(importer==null)continue;
                var settings=importer.GetDefaultPlatformTextureSettings();var standalone=importer.GetPlatformTextureSettings("Standalone");
                if(settings.format==TextureImporterFormat.RGBA32&&standalone.overridden&&standalone.format==TextureImporterFormat.RGBA32)continue;
                importer.textureType=TextureImporterType.Default;importer.alphaSource=TextureImporterAlphaSource.FromInput;importer.alphaIsTransparency=true;importer.mipmapEnabled=false;
                settings.format=TextureImporterFormat.RGBA32;settings.textureCompression=TextureImporterCompression.Uncompressed;importer.SetPlatformTextureSettings(settings);
                standalone.overridden=true;standalone.format=TextureImporterFormat.RGBA32;standalone.textureCompression=TextureImporterCompression.Uncompressed;importer.SetPlatformTextureSettings(standalone);importer.SaveAndReimport();
            }
            // Rebuild this package subasset after adopting the existing Editor
            // cache: URP requires both compute and ray-tracing representations.
            const string probeShader="Packages/com.unity.render-pipelines.core/Editor/Lighting/ProbeVolume/RenderingLayerMask/TraceRenderingLayerMask.urtshader";
            AssetDatabase.ImportAsset(probeShader,ImportAssetOptions.ForceUpdate);
            foreach(var resource in AssetDatabase.LoadAllAssetsAtPath(probeShader))Debug.Log("R23 URP resource: "+resource.GetType().FullName);
            const string pipelinePath="Assets/Ashfall/Settings/PlayableR23URP.asset";
            var pipeline=AssetDatabase.LoadAssetAtPath<UniversalRenderPipelineAsset>(pipelinePath);
            if(pipeline==null)
            {
                var renderer=ScriptableObject.CreateInstance<UniversalRendererData>();AssetDatabase.CreateAsset(renderer,"Assets/Ashfall/Settings/PlayableR23Renderer.asset");
                pipeline=UniversalRenderPipelineAsset.Create(renderer);AssetDatabase.CreateAsset(pipeline,pipelinePath);
            }
            pipeline.msaaSampleCount=4;pipeline.renderScale=1;pipeline.supportsCameraDepthTexture=false;pipeline.supportsCameraOpaqueTexture=false;
            GraphicsSettings.defaultRenderPipeline=pipeline;QualitySettings.renderPipeline=pipeline;
            Xr();
            var scene=EditorSceneManager.NewScene(NewSceneSetup.EmptyScene,NewSceneMode.Single);
            var root=new GameObject("Ashfall R23 playable VR loop");root.AddComponent<R23PlayableLoop>();
            var sun=new GameObject("R23 main light");var light=sun.AddComponent<Light>();light.type=LightType.Directional;light.intensity=1;light.shadows=LightShadows.None;sun.transform.rotation=Quaternion.Euler(53,28,0);
            RenderSettings.ambientMode=AmbientMode.Flat;RenderSettings.ambientLight=new Color(.8f,.8f,.8f);RenderSettings.skybox=null;RenderSettings.fog=false;
            // Runtime-created hand/weapon materials still need their real shaders
            // and normal-map variants retained by the build.
            var retention=new GameObject("Runtime material variants");retention.SetActive(false);
            var held=retention.AddComponent<MeshRenderer>();
            var materials=new Material[22];string[] keywords={"_NORMALMAP","_METALLICSPECGLOSSMAP","_OCCLUSIONMAP","_EMISSION"};
            for(int i=0;i<18;i++)
            {
                string shaderName=i==16?"Universal Render Pipeline/Unlit":"Universal Render Pipeline/Lit";
                var shader=Shader.Find(shaderName);if(shader==null)throw new Exception("Missing installed shader "+shaderName);
                string path="Assets/Ashfall/Settings/PlayableR23Material"+i+".mat";materials[i]=AssetDatabase.LoadAssetAtPath<Material>(path);
                if(materials[i]==null){materials[i]=new Material(shader);AssetDatabase.CreateAsset(materials[i],path);}
                materials[i].shader=shader;
                if(i<16)
                {
                    for(int bit=0;bit<keywords.Length;bit++)if((i&(1<<bit))!=0)materials[i].EnableKeyword(keywords[bit]);else materials[i].DisableKeyword(keywords[bit]);
                    materials[i].SetTexture("_BumpMap",Texture2D.normalTexture);materials[i].SetTexture("_MetallicGlossMap",Texture2D.whiteTexture);materials[i].SetTexture("_OcclusionMap",Texture2D.whiteTexture);materials[i].SetTexture("_EmissionMap",Texture2D.whiteTexture);materials[i].SetColor("_EmissionColor",(i&8)!=0?Color.white:Color.black);
                }
            }
            // Runtime Matadors glTF uses the native specular/glossiness workflow.
            materials[17].SetFloat("_WorkflowMode",0);materials[17].EnableKeyword("_SPECULAR_SETUP");materials[17].EnableKeyword("_METALLICSPECGLOSSMAP");materials[17].EnableKeyword("_NORMALMAP");materials[17].EnableKeyword("_OCCLUSIONMAP");materials[17].SetTexture("_SpecGlossMap",Texture2D.whiteTexture);materials[17].SetTexture("_BumpMap",Texture2D.normalTexture);materials[17].SetTexture("_OcclusionMap",Texture2D.whiteTexture);
            // Selective cloth uses the existing appearance wrapper's specular
            // workflow. Retain its actual runtime keyword combinations too.
            var clothShader=Resources.Load<Shader>("R23AppearanceDoubleSided");
            if(clothShader==null)throw new Exception("Missing selective cloth appearance shader");
            string[][] clothKeywords={
                new[]{"_EMISSION","_METALLICSPECGLOSSMAP","_NORMALMAP","_OCCLUSIONMAP","_SPECULAR_SETUP"},
                new[]{"_METALLICSPECGLOSSMAP","_NORMALMAP","_SPECULAR_SETUP"},
                new[]{"_SPECULAR_SETUP"},
                new[]{"_METALLICSPECGLOSSMAP","_SPECULAR_SETUP"}};
            for(int i=0;i<clothKeywords.Length;i++)
            {
                string path="Assets/Ashfall/Settings/PlayableR23ClothVariant"+i+".mat";
                var material=AssetDatabase.LoadAssetAtPath<Material>(path);
                if(material==null){material=new Material(clothShader);AssetDatabase.CreateAsset(material,path);}
                material.shader=clothShader;material.shaderKeywords=clothKeywords[i];
                material.SetTexture("_BumpMap",Texture2D.normalTexture);material.SetTexture("_MetallicGlossMap",Texture2D.whiteTexture);
                material.SetTexture("_OcclusionMap",Texture2D.whiteTexture);material.SetTexture("_EmissionMap",Texture2D.whiteTexture);
                material.SetColor("_EmissionColor",i==0?Color.white:Color.black);materials[18+i]=material;
            }
            held.sharedMaterials=materials;
            EditorSceneManager.SaveScene(scene,ScenePath);EditorBuildSettings.scenes=new[]{new EditorBuildSettingsScene(ScenePath,true)};
            PlayerSettings.productName="Ashfall R23 Unity VR";PlayerSettings.companyName="Ashfall";PlayerSettings.runInBackground=true;
            PlayerSettings.defaultIsNativeResolution=false;PlayerSettings.defaultScreenWidth=1280;PlayerSettings.defaultScreenHeight=720;PlayerSettings.fullScreenMode=FullScreenMode.Windowed;
            PlayerSettings.SetScriptingBackend(UnityEditor.Build.NamedBuildTarget.Standalone,ScriptingImplementation.Mono2x);
            AssetDatabase.SaveAssets();Debug.Log("R23 scene prepared with OpenXR and Oculus Touch profile");
        }
        public static void BuildWindows()
        {
            try
            {
                Prepare();string output=Argument("-ashfallVRBuild");
                if(String.IsNullOrEmpty(output)||!Path.IsPathRooted(output)||!output.EndsWith(".exe",StringComparison.OrdinalIgnoreCase))throw new ArgumentException("New absolute -ashfallVRBuild .exe required");
                if(Directory.Exists(Path.GetDirectoryName(output)))throw new Exception("Preserve previous build: choose a new output directory");
                Directory.CreateDirectory(Path.GetDirectoryName(output));
                bool xrDisabled=Argument("-ashfallXRDisabled")=="true";var xr=Xr();xr.InitManagerOnStart=!xrDisabled;EditorUtility.SetDirty(xr);AssetDatabase.SaveAssets();
                UnityEditor.Build.Reporting.BuildReport report;
                R25BrandingSetup.Apply();
                try{report=BuildPipeline.BuildPlayer(new BuildPlayerOptions{scenes=new[]{ScenePath},locationPathName=output,target=BuildTarget.StandaloneWindows64,options=BuildOptions.Development});}
                finally{xr.InitManagerOnStart=true;EditorUtility.SetDirty(xr);AssetDatabase.SaveAssets();}
                if(report.summary.result!=BuildResult.Succeeded||report.summary.totalErrors!=0)throw new Exception("VR build failed: "+report.summary.result+" errors="+report.summary.totalErrors);
                Debug.Log("R23 VR executable built: "+output);EditorApplication.Exit(0);
            }catch(Exception e){Debug.LogException(e);EditorApplication.Exit(2);}
        }
        // Invoke with -buildTarget Android so Unity performs its target/domain
        // transition before this method. Never installs or launches a device.
        public static void BuildQuest()
        {
            try
            {
                if(EditorUserBuildSettings.activeBuildTarget!=BuildTarget.Android)throw new Exception("Start Editor with -buildTarget Android");
                string output=Argument("-ashfallQuestBuild");
                if(String.IsNullOrEmpty(output)||!Path.IsPathRooted(output)||!output.EndsWith(".apk",StringComparison.OrdinalIgnoreCase))throw new ArgumentException("New absolute -ashfallQuestBuild .apk required");
                if(Directory.Exists(Path.GetDirectoryName(output)))throw new Exception("Preserve previous APK: choose a fresh directory");
                string sdk=Argument("-ashfallAndroidSdk");
                if(String.IsNullOrEmpty(sdk)||!Directory.Exists(Path.Combine(sdk,"licenses"))||!File.Exists(Path.Combine(sdk,"platforms/android-36/android.jar")))throw new Exception("Verified private writable Android SDK required");
                UnityEditor.Android.AndroidExternalToolsSettings.sdkRootPath=sdk;
                Debug.Log("Unity Quest private SDK: "+sdk);
                Prepare();Xr(BuildTargetGroup.Android);
                PlayerSettings.productName="ASHFALL Unity Quest";
                PlayerSettings.SetApplicationIdentifier(UnityEditor.Build.NamedBuildTarget.Android,"org.alingold.ashfallunityquest");
                PlayerSettings.bundleVersion="1.3.8-playtest-r9";PlayerSettings.Android.bundleVersionCode=18;
                PlayerSettings.SetScriptingBackend(UnityEditor.Build.NamedBuildTarget.Android,ScriptingImplementation.IL2CPP);
                PlayerSettings.SetManagedStrippingLevel(UnityEditor.Build.NamedBuildTarget.Android,ManagedStrippingLevel.Low);
                PlayerSettings.Android.targetArchitectures=AndroidArchitecture.ARM64;
                PlayerSettings.Android.minSdkVersion=AndroidSdkVersions.AndroidApiLevel32;
                PlayerSettings.Android.targetSdkVersion=AndroidSdkVersions.AndroidApiLevel36;
                PlayerSettings.Android.splitApplicationBinary=false;PlayerSettings.Android.useCustomKeystore=false;
                PlayerSettings.SetUseDefaultGraphicsAPIs(BuildTarget.Android,false);
                PlayerSettings.SetGraphicsAPIs(BuildTarget.Android,new[]{GraphicsDeviceType.Vulkan});
                EditorUserBuildSettings.buildAppBundle=false;EditorUserBuildSettings.exportAsGoogleAndroidProject=false;
                Directory.CreateDirectory(Path.GetDirectoryName(output));AssetDatabase.SaveAssets();
                R25BrandingSetup.Apply();
                var report=BuildPipeline.BuildPlayer(new BuildPlayerOptions{scenes=new[]{ScenePath},locationPathName=output,target=BuildTarget.Android,options=BuildOptions.None});
                R23QuestBuildReport.Export(Path.ChangeExtension(output,".build-report.json"));
                if(report.summary.result!=BuildResult.Succeeded||report.summary.totalErrors!=0||!File.Exists(output))throw new Exception("Quest APK failed: "+report.summary.result+" errors="+report.summary.totalErrors);
                Debug.Log("ASHFALL Unity Quest APK built (not installed): "+output);EditorApplication.Exit(0);
            }
            catch(Exception error){Debug.LogException(error);EditorApplication.Exit(2);}
        }
    }
}
#endif
