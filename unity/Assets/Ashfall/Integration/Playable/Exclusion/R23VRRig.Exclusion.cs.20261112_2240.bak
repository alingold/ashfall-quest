#if UNITY_6000_0_OR_NEWER
using Ashfall.Core;
using Ashfall.Integration.Playable.Exclusion;
using Ashfall.Integration.Playable.Expansion;
using UnityEngine;

namespace Ashfall.Integration.Playable
{
    // Exclusion glue for the local rig (features/exclusion.md):
    //  A. head-hull overlap recovery (push-out, then recent clear position);
    //  B. owner of the obstructed-view fade component;
    //  C. walking body column + walking step-up limit.
    // Everything here is local movement/presentation; nothing reaches the wire
    // except through the ordinary head track the host already validates.
    public sealed partial class R23VRRig
    {
        readonly R25HeadRecoveryPolicy headRecovery = new R25HeadRecoveryPolicy();
        readonly R25BodyColumnRules bodyColumn = new R25BodyColumnRules();
        R25ObstructedViewFade viewFade;
        bool carrierWroteRoot;
        float nextStepLog = float.NegativeInfinity;
        // Recoveries longer than this (m) also clear velocity and support state.
        const float LargeRecoveryDistance = 0.05f;
        public static float StuckEyeRadius = 0.05f;
        public static float StuckNudge = 0.02f; // R5; editor fixtures may set the old 0.12 for a before control

        public int HeadRecoveries { get; private set; }
        public int HeadRecoveryFailures { get; private set; }
        public R25ObstructedViewFade ViewFade { get { return viewFade; } }
        public bool ViewFullyObstructed() { return viewFade != null && viewFade.FullyFaded; }

        void InitializeExclusion()
        {
            if (Head == null || viewFade != null) return;
            viewFade = Head.gameObject.AddComponent<R25ObstructedViewFade>();
            viewFade.Initialize(this, Head);
        }

        // teleport=true also forgets the recent-clear history (spawn, ghost move).
        void RequestHeadRecovery(R25RecoveryReason reason, bool teleport)
        {
            if (teleport) { ResetPhysicalClearance(); headRecovery.ClearHistory(); if (viewFade != null) viewFade.NotifyRootReset(); }
            ClearGrapplePull();CancelVehicle();CancelTraversal();headRecovery.Request(reason);
        }

        // A. Runs once per Update after Advance. Records clear head positions on
        // the normal path and recovers when a check was requested or the hull has
        // failed its starting-clear test for several consecutive frames.
        void TickHeadRecovery()
        {
            if (!R25Features.HeadOverlapRecovery || !UseSourceHeadHull || !Tracking || Head == null || HeadCollision == null || !HeadCollision.Ready) return;
            bool carrier = CarrierActive || carrierWroteRoot;
            Vector3 head = Head.transform.position;
            // R5 (playtest 4 wall vibration): with the 12 cm eye sphere, rubbing
            // along a wall kept the eye inside the walking margin, so "stuck"
            // push-outs of 3-27 cm fired every few frames. Recover only when the
            // eye is genuinely inside geometry (within 5 cm of a surface).
            bool clear = carrier || (Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety
                ? !HeadCollision.EyeObstructed(head, StuckEyeRadius) : HeadCollision.HeadClear(head));
            float now = Time.realtimeSinceStartup;
#if UNITY_EDITOR
            if (HeadclipProbeOwnsTracking) now = headclipProbeClock;
            else if (fixtureFrame > 0) now = fixtureClock;
#endif
            if (carrier) { standableCount = 0; headRecovery.ResetOpaque(); headJumpInProgress = false; }
            if (!carrier && RecoverTrappedOpaque(now)) return;
            var reason = headRecovery.Tick(F(head), clear, carrier, now);
            if (reason == R25RecoveryReason.None) return;
            if (Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety
                && HoldPhysicalSupport && reason == R25RecoveryReason.Stuck)
            {
                // A physical lean blocked by the body/ledge stays opaque until
                // the user returns. Do not turn that fallback into a vertical
                // recovery push that fights real head height or sinks the feet.
                headRecovery.Completed(false, now);
                return;
            }
            Vector3 target;
            string method = "push-out";
            bool ok = HeadCollision.TryDepenetrate(head, headRecovery, out target);
            if (!ok)
            {
                for (int age = 0; age < headRecovery.HistoryCount && !ok; age++)
                {
                    Float3 candidate;
                    if (!headRecovery.TryFallback(F(head), age, out candidate) || !HeadCollision.HeadClear(U(candidate))) continue;
                    target = U(candidate);
                    ok = true;
                    method = "recent-clear-" + age;
                }
            }
            // R5: an unrequested "stuck" push-out is a gentle nudge (at most
            // 2 cm per attempt), never a jolt; repeated attempts finish the job.
            if (ok && reason == R25RecoveryReason.Stuck && method == "push-out" && Vector3.Distance(head, target) > StuckNudge)
                target = head + (target - head).normalized * StuckNudge;
            headRecovery.Completed(ok, now);
            float distance = ok ? Vector3.Distance(head, target) : 0;
            if (ok) ApplyHeadRecovery(target - head);
            else HeadRecoveryFailures++;
            int suppressed;
            if (headRecovery.ShouldLog(now, out suppressed))
                Debug.LogFormat(LogType.Log, LogOption.NoStacktrace, this, "R25 head recovery reason={0} result={1} method={2} distance={3:F3} head={4} history={5} suppressed={6}",
                    reason, ok ? "recovered" : "failed", ok ? method : "none", distance, head.ToString("F3"), headRecovery.HistoryCount, suppressed);
        }

        void ApplyHeadRecovery(Vector3 offset)
        {
            ClearGrapplePull();CancelVehicle();CancelTraversal();
            // R8: a recovery nudge out of a ceiling must not push the feet
            // through the floor (playtest 7 log: Stuck push-out at 0.58 m sunk).
            bool held; offset = KeepFeetOnFloor(transform.position, offset, out held);
            // Move the whole rig: raw tracked local poses and room-scale origin stay intact.
            body.enabled = false;
            transform.position += offset;
            body.enabled = true;
            TraceLocomotion("head-recovery");
            // A tiny contact correction (e.g. a prop or bot nudging the head) keeps
            // momentum, support and any climb grip. A real relocation starts fresh;
            // climbing anchors are kept because the swept climb cannot re-enter.
            if (offset.magnitude > LargeRecoveryDistance)
            {
                if (motor != null) motor.SetVelocity(new Float3());
                grounded = false;
                ceiling = false;
            }
            previousSourceHead = Head.transform.position;
            haveSourceHead = true;
            HeadRecoveries++;
        }

        // C. True for a supported thumbstick walk/run step only: never climbing,
        // glide/flight, pad or carrier motion, ghost mode or a jump take-off.
        bool ExclusionWalkFrame(bool otherMotionOwner, Vector3 requested)
        {
            return R25Features.WalkBodyColumn && UseSourceHeadHull && !otherMotionOwner && grounded && !SourceGhostMotion && requested.y <= 0
                && (MenuLocomotion || Activities == null || !Activities.PadLaunchActive) && HeadCollision != null && HeadCollision.Ready
                && bodyColumn.Walking(F(requested));
        }

        // R4 (playtest 3): the walking chest column used to stop thumbstick
        // walking at anything taller than 0.45 m. The owner's rule is that you
        // walk up onto anything shorter than your chin (automatic mantle), so
        // walking is no longer clipped by the column; the head sweep still stops
        // anything at chin height or above. Physical head pushes keep the column.
        Vector3 WalkBodyColumn(Vector3 requested)
        {
            return requested;
        }

        // Walking may step up at most bodyColumn.StepHeight. A taller rise found
        // under the eye during a walk step undoes this frame's walk instead (the
        // previous position was supported), so the player is never popped on top
        // of a table or railing and never loses the floor beneath them.
        bool RefuseWalkStep(bool walked, float rise, Vector3 before)
        {
            // R4: the chin limit applies to every ordinary support step-up (walk
            // or physical lean); only a walk is also undone to its last support.
            float eyeHeight = Head.transform.position.y - transform.position.y;
            if (!bodyColumn.RefuseWalkStep(true, rise, eyeHeight)) return false;
            if (walked)
            {
                body.enabled = false;
                transform.position = before;
                body.enabled = true;
                TraceLocomotion("step-refused");
            }
            float now = Time.realtimeSinceStartup;
            if (now >= nextStepLog)
            {
                nextStepLog = now + 2;
                Debug.LogFormat(LogType.Log, LogOption.NoStacktrace, this, "R25 walk step-up refused rise={0:F3} limit={1:F2}", rise, bodyColumn.WalkStepLimit(eyeHeight));
            }
            return true;
        }
    }
}
#endif
