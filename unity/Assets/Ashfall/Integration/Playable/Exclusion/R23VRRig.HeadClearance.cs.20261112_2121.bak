#if UNITY_6000_0_OR_NEWER
using Ashfall.Core;
using Ashfall.Integration.Playable.Exclusion;
using Ashfall.Integration.Playable.Expansion;
using UnityEngine;
namespace Ashfall.Integration.Playable
{
    public sealed partial class R23VRRig
    {
        readonly R25HeadClearance headClearance = new R25HeadClearance();
        float nextClearanceLog;
        int pushFrame = -1;
        float pushUsed;
        Vector3 physicalNeutral;
        bool havePhysicalNeutral, physicalSupportHold, headJumpInProgress, headMotionOwned;
        float physicalNeutralSince = -1, lastPhysicalBlock = -1;
        float ClearanceClock
        {
            get
            {
#if UNITY_EDITOR
                if (HeadclipProbeOwnsTracking) return headclipProbeClock;
                if (fixtureFrame > 0) return fixtureClock;
#endif
                return Time.realtimeSinceStartup;
            }
        }
        // Per-frame budgets (push, crouch release) key on the rendered frame. An
        // editor fixture that runs many simulation steps inside one editor frame
        // supplies its own step counter instead (no effect in a player build).
        int SimFrame
        {
            get
            {
#if UNITY_EDITOR
                if (fixtureFrame > 0) return fixtureFrame;
#endif
                return Time.frameCount;
            }
        }
        readonly Vector3[] standableRoots = new Vector3[8];
        int standableCount, standableNewest;
        float nextStandableSample;
        public int TrappedOpaqueRecoveries { get; private set; }
        public int TrappedOpaqueFailures { get; private set; }
        bool HoldPhysicalSupport
        {
            get { return Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety
                && !CarrierActive && !headMotionOwned && holdFeetSupported
                && (physicalSupportHold && !headJumpInProgress || HeadClearanceBlocked || ViewFullyObstructed()); }
        }
        // R5 (playtest 4 "stay in the air"): the hold exists only to stop a
        // physical lean from sinking the feet through the floor they stand on.
        // It never applies unless that floor is really under the feet, so a
        // head touching something while airborne can no longer suspend you.
        bool holdFeetSupported;
        bool FeetOnFloor(Vector3 feet)
        {
            RaycastHit floor;
            return HeadCollision != null && HeadCollision.Support(feet, feet + Vector3.up * .3f, out floor)
                && floor.point.y <= feet.y + .03f && floor.point.y >= feet.y - .05f;
        }
        void PrepareHeadRootMotion(bool ownsMotion, bool jumped)
        {
            holdFeetSupported = FeetOnFloor(transform.position);
            headMotionOwned = ownsMotion;
            if (grounded || ownsMotion) headJumpInProgress = false;
            if (jumped && !ownsMotion) headJumpInProgress = true;
            // Clear, deliberate walking is ordinary locomotion, including real
            // head bob and duck transitions. Keep the hold for actual blocked
            // tracking paths, opacity, and this frame's physical correction.
            bool moving = LastFrame.MoveX * LastFrame.MoveX + LastFrame.MoveY * LastFrame.MoveY > .0225f;
            bool correcting = pushFrame == SimFrame && pushUsed > .00001f;
            if (physicalSupportHold && moving && !correcting && !HeadClearanceBlocked && !ViewFullyObstructed()
                && HeadCollision.HeadClear(Head.transform.position))
            {
                physicalNeutral = Head.transform.localPosition;
                physicalSupportHold = false; physicalNeutralSince = -1;
            }
        }
        void ResetPhysicalClearance()
        {
            ResetRampCrouch();
            havePhysicalNeutral = false; physicalSupportHold = false; physicalNeutralSince = -1; lastPhysicalBlock = -1; headJumpInProgress = false; headMotionOwned = false;
            standableCount = 0; nextStandableSample = 0;
            headRecovery.ResetOpaque(); HeadClearanceBlocked = false;
        }
        void ObservePhysicalSupport()
        {
            if (!Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety) { physicalSupportHold = false; return; }
            if (!havePhysicalNeutral) { physicalNeutral = Head.transform.localPosition; havePhysicalNeutral = true; }
            float now = ClearanceClock;
            // R4 (playtest 3): hold support only while the real head is actually
            // being blocked by geometry (and for a short tail afterwards). Any
            // 5 mm of ordinary head motion used to set the hold, and in a real
            // headset it then never released until the thumbstick moved, so
            // gravity stopped working while standing still.
            bool displaced = HeadClearanceBlocked || lastPhysicalBlock >= 0 && now - lastPhysicalBlock < .1f;
            if (displaced) { physicalSupportHold = true; physicalNeutralSince = -1; }
            else if (!HeadClearanceBlocked && !ViewFullyObstructed())
            {
                // Update and before-render poses may straddle the same lean.
                // Require a short continuous neutral interval before gravity
                // can resume, rather than toggling support between samples.
                if (physicalNeutralSince < 0) physicalNeutralSince = now;
                if (now - physicalNeutralSince >= .1f) physicalSupportHold = false;
            }
        }
        void RecordStandable(float now)
        {
            RaycastHit floor;
            if (CarrierActive || HeadClearanceBlocked || !grounded || !HeadCollision.HeadClear(Head.transform.position)
                || !HeadCollision.Support(transform.position, Head.transform.position, out floor)
                || Mathf.Abs(floor.point.y - transform.position.y) > .03f || now < nextStandableSample) return;
            if (standableCount > 0 && Vector3.Distance(standableRoots[standableNewest], transform.position) < .1f) return;
            if (standableCount > 0) standableNewest = (standableNewest + 1) % standableRoots.Length;
            standableRoots[standableNewest] = transform.position;
            standableCount = Mathf.Min(standableCount + 1, standableRoots.Length);
            nextStandableSample = now + .25f;
        }
        bool RecoverTrappedOpaque(float now)
        {
            if (!Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety || CarrierActive) return false;
            RecordStandable(now);
            if (!headRecovery.TickOpaque(F(Head.transform.position), ViewFullyObstructed(), now)) return false;
            Vector3 relative = Head.transform.position - transform.position;
            for (int age = 0; age < standableCount; age++)
            {
                Vector3 root = standableRoots[(standableNewest - age + standableRoots.Length) % standableRoots.Length];
                Vector3 eye = root + relative; RaycastHit floor;
                if (Vector3.Distance(root, transform.position) > headRecovery.MaxFallbackDistance
                    || !HeadCollision.HeadClear(eye) || !HeadCollision.Support(root, eye, out floor)
                    || Mathf.Abs(floor.point.y - root.y) > .03f) continue;
                // A relocation happens only behind the opaque view and never
                // changes raw tracking or rotation. Validate the current pose.
                ApplyHeadRecovery(root - transform.position);
                HeadClearanceBlocked = false; grounded = true;
                physicalSupportHold = false;
                viewFade.NotifyRootReset(); TrappedOpaqueRecoveries++;
                Debug.LogFormat(LogType.Log, LogOption.NoStacktrace, this,
                    "R25 head recovery reason=TrappedOpaque result=recovered root={0}", root.ToString("F3"));
                return true;
            }
            TrappedOpaqueFailures++;
            Debug.LogFormat(LogType.Warning, LogOption.NoStacktrace, this,
                "R25 head recovery reason=TrappedOpaque result=failed history={0} head={1}", standableCount, Head.transform.position.ToString("F3"));
            return false;
        }
        public bool HeadClearanceBlocked { get; private set; }
#if UNITY_EDITOR
        public string VerifiedPath = "";
#endif
        void LogClearance(string reason, float amount)
        {
            if (amount < .0001f || Time.realtimeSinceStartup < nextClearanceLog) return;
            nextClearanceLog = Time.realtimeSinceStartup + 1;
            Debug.LogFormat(LogType.Log, LogOption.NoStacktrace, this,
                "R25 head clearance reason={0} head={1} amount={2:F4}", reason, Head.transform.position.ToString("F3"), amount);
        }
        Vector3 VerifiedHeadMotion(Vector3 head, Vector3 requested, bool slide, bool standing, out bool hitCeiling, bool rootMotion = false)
        {
            if (rootMotion && standing)
            {
                requested = CrouchWalk(requested);
                head = Head.transform.position;
            }
#if UNITY_EDITOR
            if (rootMotion) headclipRootWasProtected = HoldPhysicalSupport;
#endif
            if (!R25Features.HeadClearance) return HeadCollision.Sweep(head, requested, slide, out hitCeiling, standing);
            if (rootMotion && HoldPhysicalSupport && requested.y < 0) requested.y = 0;
#if UNITY_EDITOR
            if (rootMotion && CaptureAdvanceTrace) VerifiedPath = "headClear=" + HeadCollision.HeadClear(head) + " obstructed12=" + HeadCollision.EyeObstructed(head, .12f) + " head=" + head.ToString("F3");
#endif
            if (Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety && !HeadCollision.HeadClear(head))
            {
                // R5 (playtest 4 wall rub): once the eye has crossed a surface the
                // nearest face lies behind it, so "away from the nearest surface"
                // pointed deeper into the wall. Use the last clear eye instead:
                // root motion may slide along or return, never move further from it.
                RaycastHit crossed;
                if (rootMotion && haveSourceHead && HeadCollision.Ray(previousSourceHead, head, out crossed))
                {
                    Vector3 back = previousSourceHead - head; back.y = 0;
                    if (back.sqrMagnitude > .000001f)
                    {
                        Vector3 n = back.normalized; float away = Vector3.Dot(requested, n);
                        if (away < 0) requested -= away * n;
                    }
                }
                Vector3 escape = HeadCollision.EscapeEyeMotion(head, requested, slide, out hitCeiling);
                if (rootMotion && standing) escape = LevelStandingWalk(head, requested, escape);
                return rootMotion && HoldPhysicalSupport && escape.y < 0 ? Vector3.zero : escape;
            }
            bool ceilingHit = false;
            Float3 safe = headClearance.Move(F(head), F(requested), delegate(Float3 at, Float3 delta) {
                bool hit; Vector3 result = HeadCollision.Sweep(U(at), U(delta), slide, out hit, standing, true);
                ceilingHit |= hit; return F(result);
            }, delegate(Float3 at) { return HeadCollision.HeadClear(U(at)); },
                Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety ? 0 : R25HeadClearance.Skin);
            hitCeiling = ceilingHit;
            LogClearance("motion-refused", (U(safe)-requested).magnitude);
            Vector3 accepted = U(safe);
            if (rootMotion && standing) accepted = LevelStandingWalk(head, requested, accepted);
            if (rootMotion && HoldPhysicalSupport && accepted.y < 0) accepted = Vector3.zero;
            return accepted;
        }
        // R4: a supported thumbstick walk never gains height by sliding the head
        // up an edge. Height comes only from the support step-up rule, which is
        // limited to the chin. Keep the level part if it is clear, else stop.
        Vector3 LevelStandingWalk(Vector3 head, Vector3 requested, Vector3 accepted)
        {
            // R5 (playtest 4 wall rub): a walk may never leave the eye on the far
            // side of a surface from its last clear position. If it would (or the
            // eye has already crossed), walk no further and ease back toward the
            // clear side instead of popping later.
            RaycastHit crossed;
            if (haveSourceHead && HeadCollision.Ray(previousSourceHead, head + accepted, out crossed))
            {
                Vector3 back = previousSourceHead - head; back.y = 0;
                return back.sqrMagnitude > .0025f ? back.normalized * .05f : back;
            }
            float allowed = Mathf.Max(0, requested.y);
            if (accepted.y <= allowed + .0001f) return accepted;
            Vector3 level = new Vector3(accepted.x, allowed, accepted.z);
            return HeadCollision.HeadClear(head + level) ? level : Vector3.zero;
        }
        bool ResolveVerifiedSupport(Vector3 feet, Vector3 eye, Vector3 velocity, float seconds, float maximumRise, bool drop, out Vector3 correction)
        {
            if (!R25Features.HeadClearance) return HeadCollision.ResolveSupport(feet, eye, velocity, seconds, maximumRise, drop, out correction);
            correction = Vector3.zero;
            RaycastHit floor;
            if (!HeadCollision.Support(feet, eye, out floor)) return HoldPhysicalSupport;
            if (HoldPhysicalSupport && floor.point.y <= feet.y + .0001f) return true;
            float rise = floor.point.y-feet.y;
            float allowance = .03f + (floor.normal.y < .999f ? Vector3.ProjectOnPlane(velocity,Vector3.up).magnitude*seconds*Mathf.Tan(65*Mathf.Deg2Rad) : 0);
            if (rise > maximumRise+.005f)
            {
                // R4: the surface under the eye is above the chin (e.g. leaning
                // over a high ledge). Keep standing on the floor under the feet
                // instead of losing support and sinking through it.
                RaycastHit own;
                return velocity.y <= .05f && HeadCollision.Support(feet, feet + Vector3.up * .3f, out own) && Mathf.Abs(own.point.y - feet.y) <= .03f;
            }
            if (rise < -.27f || rise < -allowance && !drop || rise < -.01f && velocity.y > .05f) return false;
            Float3 accepted = new Float3();
            System.Func<Vector3, bool> riseFrom = delegate(Vector3 from) {
                return headClearance.Rise(F(from), rise, delegate(Float3 at, Float3 delta) {
                    bool hit; return F(HeadCollision.Sweep(U(at), U(delta), false, out hit, false, true));
                }, delegate(Float3 at) { return HeadCollision.HeadClear(U(at)); }, out accepted);
            };
            bool ok = riseFrom(eye);
            if (!ok && rise > .001f && CanRampCrouch)
            {
                // R6 (playtest 5): stepping up a floor that rises under an overhang.
                // The overhead blocks the eye's rise: crouch by the rise (never
                // below the minimum eye height) and take the step, instead of
                // refusing the walk every frame. R7: through the single crouch owner.
                float room = eye.y - feet.y - R25RampCrouch.MinimumEyeHeight;
                float add = Mathf.Min(room, rise + .02f);
                if (CrouchForRise(add))
                {
                    ok = riseFrom(eye - Vector3.up * add);
                    if (!ok) UndoCrouchForRise(add);
                }
            }
            correction = U(accepted);
            return ok;
        }
        void RefuseBlockedSupport(bool walked, Vector3 before)
        {
            if (!R25Features.HeadClearance || !walked) return;
            RaycastHit floor;
            if (!HeadCollision.Support(transform.position, Head.transform.position, out floor) || floor.point.y <= transform.position.y+.0001f) return;
            LogClearance("support-refused", Vector3.Distance(before,transform.position));
            body.enabled=false;transform.position=before;body.enabled=true;grounded=true;
        }
        void SynchronizeClearanceHead()
        {
            holdFeetSupported = FeetOnFloor(transform.position);
            CrouchPhysicalHead();
            ObservePhysicalSupport();
            Vector3 desired=Head.transform.position;
            HeadClearanceBlocked=false;
            if (haveSourceHead)
            {
                bool hit;
                Vector3 safe=VerifiedHeadMotion(previousSourceHead,desired-previousSourceHead,false,false,out hit);
                Vector3 blocked=previousSourceHead+safe-desired;
                if (blocked.sqrMagnitude>.000001f) {physicalSupportHold=true;physicalNeutralSince=-1;lastPhysicalBlock=ClearanceClock;}
                if (pushFrame!=SimFrame) {pushFrame=SimFrame;pushUsed=0;}
                Float3 push=headClearance.Push(F(blocked),R25HeadClearance.PushLimit-pushUsed,
                    delegate(Float3 delta) { return F(HeadCollision.BodyColumnMotion(transform.position,previousSourceHead,U(delta),bodyColumn)); },
                    delegate(Float3 delta) {
                        RaycastHit floor;
                        return !grounded || HeadCollision.Support(transform.position+U(delta),previousSourceHead+U(delta),out floor)
                            && Mathf.Abs(floor.point.y-transform.position.y)<=.03f;
                    });
                body.enabled=false;transform.position+=U(push);body.enabled=true;
                pushUsed+=R25HeadClearance.Length(push);
                LogClearance("physical-push",R25HeadClearance.Length(push));
                HeadClearanceBlocked=!HeadCollision.HeadClear(Head.transform.position)
                    || Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety && (blocked+U(push)).sqrMagnitude>.000001f;
                if (HeadClearanceBlocked) LogClearance("physical-fade",blocked.magnitude);
                // A blocked body/ledge or vertical-only contact falls back to fade.
                // Never change real head height, rotate the rig or teleport feet.
            }
            if ((!Ashfall.Integration.Playable.Climbing.R23HeadCollision.FullEyeSafety || !HeadClearanceBlocked) && !physicalSupportHold && HeadCollision.HeadClear(Head.transform.position))
            {
                // Retain source feet recentering, but sweep the body at the old
                // root and check support before moving it. Counter-move origin
                // so accepted head/hands never move during this bookkeeping.
                Vector3 rootEye=new Vector3(transform.position.x,Head.transform.position.y,transform.position.z);
                Float3 recenter=headClearance.Push(F(Head.transform.position-rootEye),R25HeadClearance.PushLimit-pushUsed,
                    delegate(Float3 delta) { return F(HeadCollision.BodyColumnMotion(transform.position,rootEye,U(delta),bodyColumn)); },
                    delegate(Float3 delta) {
                        RaycastHit floor;
                        return !grounded || HeadCollision.Support(transform.position+U(delta),rootEye+U(delta),out floor)
                            && Mathf.Abs(floor.point.y-transform.position.y)<=.03f;
                    });
                Vector3 origin=TrackingOrigin.position;
                body.enabled=false;transform.position+=U(recenter);TrackingOrigin.position=origin;body.enabled=true;
                artificialOriginOffset+=U(recenter);
                pushUsed+=R25HeadClearance.Length(recenter);
                previousSourceHead=Head.transform.position;haveSourceHead=true;
            }
        }
    }
}
#endif
