                {if(RefuseWalkStep(exclusionWalk,correction.y,before))correction=Vector3.zero;else{body.enabled=false;transform.position+=correction;body.enabled=true;}grounded=true;supportCorrection=correction;}else RefuseBlockedSupport(exclusionWalk,before);
            }
