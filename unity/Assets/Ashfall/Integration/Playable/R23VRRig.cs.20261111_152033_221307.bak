            var climb=new R23ClimbMotion();bool exclusionFlight=false, exclusionFlightOwnsSupport=false;bool evaluatedClimb=!pull&&!vehicle&&Climbing!=null&&sample.IsXr&&!MenuLocomotion;
            if(evaluatedClimb)
