            input.Ownership.Dominant=PrimaryHand==0?DominantHand.Left:DominantHand.Right;
            var sample=R23InputProjection.Sample(focused,Tracking,F(transform.InverseTransformPoint(Head.transform.position)),left,right,MotionPaused,PrimaryHand,ReservePrimaryMarkTurn);
