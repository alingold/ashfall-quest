        public bool TryLaunchPad(Vector3 normal,float speed)
        {
            if(BeingGrappled||Riding||motor==null||Activities==null||!LastFrame.Tracked||LastFrame.Paused||!new Float3(normal.x,normal.y,normal.z).IsFinite||float.IsNaN(speed)||float.IsInfinity(speed)||speed<=0||speed>1000)return false;
            Vector3 velocity;
