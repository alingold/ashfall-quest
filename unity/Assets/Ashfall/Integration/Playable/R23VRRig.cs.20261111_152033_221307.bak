                climb=Climbing.Evaluate(frame,seconds,sample.Left.Tracked,sample.Right.Tracked,!LeftHandOccupied&&!LeftObjectiveGripReserved,!RightHandOccupied&&!RightObjectiveGripReserved,U(previousVelocity));
